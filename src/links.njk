---
layout: base.njk
title: Article URLs
permalink: /links/
description: "Internal tool — all article URLs for campaigns."
noAds: true
noindex: true
pageType: policy
---
<div class="page page--single">
<main class="home">
  <section class="home-featured">
    <span class="eyebrow">Internal tool</span>
    <h1>Article URLs</h1>
    <p class="standfirst">{{ collections.articles | length }} published articles. Not linked anywhere, not indexed.</p>
    <p><button type="button" class="copy-all-btn" onclick="copyAll(this)">Copy all URLs</button></p>
  </section>
  <section class="home-latest">
    <table class="links-table">
      <thead><tr><th>Article</th><th>URL</th><th></th></tr></thead>
      <tbody>
      {% for post in collections.articles %}
        <tr>
          <td>{{ post.data.title }}</td>
          <td class="link-url">{{ site.url }}{{ post.url }}</td>
          <td><button type="button" onclick="copyOne(this)">Copy</button></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
</main>
</div>
<style>
.links-table{width:100%;border-collapse:collapse;font-size:.85rem;margin-top:12px}
.links-table th{text-align:left;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);border-bottom:2px solid var(--ink);padding:8px}
.links-table td{padding:9px 8px;border-bottom:1px solid var(--rule);vertical-align:top}
.link-url{font-family:ui-monospace,monospace;font-size:.78rem;word-break:break-all;color:var(--ink-soft)}
.links-table button,.copy-all-btn{padding:6px 12px;border:1px solid var(--rule);border-radius:7px;background:#fff;cursor:pointer;font-size:.8rem;font-weight:600;color:var(--accent)}
.copy-all-btn{background:var(--accent);color:#fff;border-color:var(--accent);padding:10px 18px}
.links-table button:hover,.copy-all-btn:hover{filter:brightness(1.08)}
</style>
<script>
function flash(btn, label){ var t=btn.textContent; btn.textContent=label; setTimeout(function(){btn.textContent=t;},1200); }
function copyOne(btn){
  var url = btn.closest('tr').querySelector('.link-url').textContent.trim();
  navigator.clipboard.writeText(url).then(function(){ flash(btn,'Copied!'); });
}
function copyAll(btn){
  var urls = Array.from(document.querySelectorAll('.link-url')).map(function(td){ return td.textContent.trim(); }).join('\n');
  navigator.clipboard.writeText(urls).then(function(){ flash(btn,'Copied ' + urls.split('\n').length + ' URLs!'); });
}
</script>
